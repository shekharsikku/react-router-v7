{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["node", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-non-null-asserted-optional-chain": "allow"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/node_modules", "**/dist", "**/test"]
}
